# 이 파일을 .env로 복사해서 실제 값을 채워 넣는다. .env 자체는 git에 커밋되지 않는다.

# Gemini API
GOOGLE_API_KEY=
MODEL_NAME=gemini-3.1-flash-lite
# Live API 전용 모델 — batch용 MODEL_NAME과 다른 모델이라 분리 (docs/integration-points.md)
LIVE_MODEL_NAME=models/gemini-3.1-flash-live-preview
# Live API 프리셋 목소리(30종 중 하나) — Zephyr+피치/포먼트 시프트가 실제 청취 비교로 확정됨
# (처음엔 Fenrir로 정했었으나 교수님 피드백으로 Zephyr로 교체, 2026-07-28)
LIVE_VOICE_NAME=Zephyr

# Dynamixel 포트 — 비워두면 hardware/config.py가 자동 탐색을 시도한다
DXL_PORT=
DXL_BAUD=57600
DXL_PROTO=2.0

# 바퀴 회전 속도(rpm)
BASE_RPM=25.0
TURN_RPM=25.0

# "한 바퀴 돌아봐"(spin_around) 제자리 회전 — SPIN_360_DURATION_SEC는 로봇/바닥마다
# 달라 실물에서 눈으로 맞춘다(scripts/test_motions.py 9번 메뉴). 방향이 반대면 SPIN_DIR 부호만 뒤집기.
SPIN_TURN_RPM=25.0
SPIN_360_DURATION_SEC=4.0
SPIN_DIR=1

# 에코캔슬레이션(스피커→마이크 barge-in 오탐 방지, media/audio_manager.py)
ENABLE_AEC=true
# 스피커->마이크 왕복 지연 추정치(ms) — 실측 안 된 값, 에코가 안 잡히면 조정해볼 것
AEC_STREAM_DELAY_MS=100

# 플레이아웃 지터 버퍼(2026-08-10, 40단계) — 재생을 시작하기 전에 쌓아두는 쿠션(ms).
# "모티가 말하다 중간에 먹힌다"의 실제 처방은 이 값이다(VOICE_SHIFT_BUFFER_MS가 아님 —
# 아래 주석 참고). 세션 종료 시 "스피커 언더런 N회" 로그가 뜨면 이 값을 올릴 것.
# 올린 만큼 발화 시작이 늦어지는 트레이드오프.
PLAYOUT_PRIME_MS=600
# 아주 짧은 대답("네!")은 위 쿠션을 영영 못 채우므로, 첫 오디오 뒤 이 시간이 지나면
# 덜 찼어도 그냥 재생을 시작한다(초).
PLAYOUT_PRIME_TIMEOUT_SEC=0.5

# 목소리 피치/포먼트 시프트(media/voice_shift.py) — Gemini 프리셋이 전부 성인 음색이라
# 재생 직전에 더 앳된 톤으로 후처리한다. 끄면 LIVE_VOICE_NAME 원본 그대로 재생됨.
# +4st/x1.15로 시작했으나 프로덕션(청크) 방식에서 기계음이 살짝 섞여 들려 강도를 낮춤(확정값).
ENABLE_VOICE_SHIFT=true
VOICE_PITCH_SEMITONES=3.5
VOICE_FORMANT_RATIO=1.12
# 한 번에 변조할 오디오 블록 길이(ms). **끊김이 난다고 이 값을 키우지 말 것** —
# 2026-08-10 실측으로 확정: 이 버퍼는 재생 언더런 여유를 1ms도 만들어주지 않는다
# (블록 N의 변조 완료 시각과 재생 필요 시각이 항상 같아 여유가 구조적으로 0).
# 과거에 500 -> 700 -> 1200으로 세 번 키웠지만 전부 효과가 없었고 발화 시작만 느려졌다.
# 끊김 대응은 위 PLAYOUT_PRIME_MS로 할 것. 근거: scripts/test_playout_margin.py.
VOICE_SHIFT_BUFFER_MS=500
# 청크 경계 오버랩-크로스페이드 길이(ms) — 경계 톤 끊김 방지(2026-08-07, 32단계).
# 늘리면 경계가 더 매끄러워지지만 재생 지연과 CPU가 그만큼 늘어난다.
VOICE_SHIFT_OVERLAP_MS=120
# 입력이 이만큼 끊기면 버퍼가 덜 찼어도 자투리를 바로 내보낸다(2026-08-10, 41단계).
# 예전엔 자투리를 서버의 turn_complete까지 붙잡아서, 그게 늦게 오면 문장 끝이 끊겼다
# ("이 물건은 무엇일까요?"의 '무엇'과 '일까요?' 사이). 웬만하면 그대로 둘 것.
VOICE_SHIFT_IDLE_FLUSH_MS=150

# 퀴즈 진행 중 barge-in(끼어들기) 끄기 — 2026-08-10 사용자 요청, 42단계.
# 로봇이 말하는 동안 마이크 오디오를 서버로 안 보내는 방식으로 구현한다(Live API의 자동
# VAD는 연결 시점 설정이라 세션 도중 못 끔). 퀴즈 밖 일반 대화의 barge-in은 항상 켜져
# 있고 이 값과 무관하다. 참가자 답변 앞부분이 잘리는 문제가 생기면 false로.
QUIZ_DISABLE_BARGE_IN=true

# 퀴즈 사진 창(display/quiz_window.py)
# 창을 띄울 모니터 인덱스(0부터) — 표정 UI(display/main.py)는 모니터가 2개 이상이면 #1을 쓴다
QUIZ_WINDOW_MONITOR_INDEX=0
# 퀴즈 창만 다른 X 디스플레이로 보내기 — 얼굴 UI는 로봇 물리화면에 두고 퀴즈 창은
# 참가자 노트북으로 온 ssh -X 포워딩 디스플레이(예: localhost:10.0)에 띄우고 싶을 때.
# 비어있으면 얼굴 UI와 같은 X 서버를 쓴다. (Jetson 실물 이식 때 추가 — jetson-moti 브랜치)
QUIZ_WINDOW_DISPLAY=
# 항상 위 고정 — 실험(로봇 운용) 중엔 반드시 1. 개발/테스트 중 터미널이 가려지면 0으로
# (0일 때만 Esc로 창 닫기가 활성화된다 — 실험 중 Esc 오입력 사고 방지용 구분)
QUIZ_WINDOW_TOPMOST=1

# ⭐ 실험 모드 — 토큰 절감(2026-08-10). true면 시스템 인스트럭션에서 자유 대화용 덩어리
# (한동대 문화 정의, 심층 상담 툴킷, 동아리 리스트, 기억 동기화 원칙)를 통째로 뺀다.
# Live API는 시스템 인스트럭션을 매 턴 입력에 포함하므로, 안 쓰는 분량이 턴 수만큼
# 곱해져 그대로 비용이 된다(실측: 31,230자 -> 15,377자, 약 51% 절감).
# 퀴즈 실험이 끝나고 평소 공감 대화로 쓸 거면 false로 되돌리세요.
QUIZ_EXPERIMENT_MODE=true

# 잠든(SLEEPY) 동안 조용한 마이크 오디오를 서버로 올리지 않는 문턱값(int16 RMS).
# Live API는 마이크 오디오를 전부 입력 토큰으로 과금해서, 아무도 없는 대기 시간이 그대로
# 비용이 된다. 사람이 말을 걸면 이 값을 훌쩍 넘으므로 깨우기는 그대로 동작한다.
# 로봇이 잘 안 깨어나면 낮추고(예: 300), 기능을 끄려면 0.
SLEEP_MIC_RMS_THRESHOLD=500

# ⭐ 참가자마다 반드시 바꿀 값 — 이번 참가자 번호. 산출물이 user_result/{이 값}/{날짜_시각}/
# 아래에 대화록+퀴즈 결과+session_meta.json으로 함께 저장된다(core/result_paths.py).
# 로봇이 대화 중 알아낸 이름 대신 이 값을 쓰는 이유: 참가자가 이름을 안 말해도 산출물이
# 항상 올바른 폴더에 남고, 논문 데이터가 실명 없이 익명화된다.
# 비어 있거나 폴더명에 못 쓰는 문자가 있으면 launcher가 시작 시점에 즉시 죽는다.
# 실험이 아닌 평소 대화로 켤 때는 아무 값이나(예: test) 넣으면 된다.
PARTICIPANT_ID=P01

# ⭐ 참가자마다 반드시 확인할 값 — 이 참가자에게 배정된 모드 순서(완전 카운터밸런싱 6순열).
# 1=척척박사, 2=하찮미, 3=짜증유발. "2,3,1"처럼 세 모드를 정확히 한 번씩 적는다
# (이름으로 적어도 된다: "하찮미,짜증유발,척척박사"). 참가자는 모드를 고르지 않고,
# 이 순서대로 5문제씩 3라운드(총 15문제)가 한 번에 이어서 진행된다.
# 잘못 적으면 launcher가 시작 시점에 즉시 죽는다(조용히 기본값으로 넘어가지 않는다).
QUIZ_MODE_ORDER=1,2,3

# 크래시 복구 전용(core/quiz_tools.py, docs/experiment_design.md "실험 운영 시 알아둘 것"):
# 세션이 도중에 죽어 launcher를 재시작할 때, 참가자가 이미 마친 라운드 수를 넣으면
# 이미 진행한 모드와 이미 정답이 공개된 사진 슬라이스를 둘 다 건너뛴다.
# ⚠️ 그 참가자가 끝나면 반드시 지우거나 0으로!
QUIZ_ROUND_OFFSET=0

# ===========================================================================
# Jetson / 리눅스 이식용 설정 (2026-08-24, jetson-moti 브랜치)
# 아래 값들은 전부 비워두면 Windows에서 지금까지 돌던 것과 똑같이 동작한다.
# 실제로 뭘 채워야 하는지는 `python scripts/jetson_doctor.py` 가 알려준다.
# ===========================================================================

# --- 카메라 (vision/camera.py) ---
# auto  : 플랫폼에 맞게 자동 (Windows=dshow, 리눅스=v4l2)  ← 기본
# v4l2  : 리눅스 USB 웹캠
# gstreamer : CSI 카메라(nvarguscamerasrc) 또는 아래 CAMERA_GST_PIPELINE 사용
CAMERA_BACKEND=auto
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
# 리눅스 USB 웹캠은 이 값이 비면 무압축(YUYV)으로 잡혀 720p에서 fps가 반토막 난다.
# 리눅스에서는 지정 안 해도 MJPG가 기본으로 들어간다 — 카메라가 MJPG를 지원 안 하면 비울 것.
CAMERA_FOURCC=
# CSI 카메라를 거꾸로 달았으면 2 (nvvidconv flip-method)
CSI_FLIP_METHOD=0
# 파이프라인을 직접 짜고 싶을 때만. 값이 있으면 CAMERA_BACKEND보다 우선한다.
CAMERA_GST_PIPELINE=

# --- 얼굴인식 가속 (vision/vision_brain.py) ---
# 비워두면 CUDA -> CPU 순으로 시도하되, **실제로 설치된 onnxruntime이 지원하는 것만** 요청한다.
# Jetson에서 TensorRT를 쓰고 싶으면: TensorrtExecutionProvider,CUDAExecutionProvider,CPUExecutionProvider
# (첫 실행 때 엔진 빌드로 수 분 걸린다 — 시연 직전에 처음 켜지 말 것)
ORT_PROVIDERS=
# 얼굴 검출 입력 해상도. 640이 기존값이자 정확도 기준. CPU로만 돌아간다면 320으로 낮출 것.
FACE_DET_SIZE=640

# --- 오디오 장치 (media/audio_manager.py) ---
# 비워두면 시스템 기본 장치. 리눅스에서는 기본이 HDMI 출력 등으로 잘못 잡히는 일이 흔하다.
# 인덱스(예: 11)로도, 이름 일부(예: USB Audio)로도 지정할 수 있다.
# 목록 확인: python scripts/jetson_doctor.py --audio
MIC_DEVICE=
SPEAKER_DEVICE=

# ── 로컬 뇌(MOTI_BRAIN, AGX Orin) 연결 ── docs/robot_integration.md 참고
# 비워두면 launcher.py 기본값(ws://192.168.0.5:8765) 사용.
# 유선이 안 되면 WiFi 192.168.0.247:8765로 바꿔볼 것.
BRAIN_URI=ws://192.168.0.5:8765
# 대답 생성 중 "음...", "흠..." 맞장구(뇌 EXP-12). 실물에선 타이밍이 안 맞아
# 인위적으로 들려서 끔(2026-09-22). 다시 켜려면 true.
BRAIN_BACKCHANNEL=false
