# 이 파일을 .env로 복사해서 실제 값을 채워 넣는다. .env 자체는 git에 커밋되지 않는다.

# Gemini API
GOOGLE_API_KEY=
MODEL_NAME=gemini-3.1-flash-lite
# Live API 전용 모델 — batch용 MODEL_NAME과 다른 모델이라 분리 (docs/integration-points.md)
LIVE_MODEL_NAME=models/gemini-3.1-flash-live-preview

# Dynamixel 포트 — 비워두면 hardware/config.py가 자동 탐색을 시도한다
DXL_PORT=
DXL_BAUD=57600
DXL_PROTO=2.0

# 바퀴 회전 속도(rpm)
BASE_RPM=25.0
TURN_RPM=25.0
